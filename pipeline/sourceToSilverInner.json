{
	"name": "sourceToSilverInner",
	"properties": {
		"activities": [
			{
				"name": "readTableidFromMain",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * FROM ctrl.table_config WHERE table_id = @{pipeline().parameters.table_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_azureSqlDB",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "startTime",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "start_time",
					"value": {
						"value": "@formatDateTime(utcNow(), 'yyyy-MM-dd_hh:mm:ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "landingToBronzeNB",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "checkSourceSystem",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/caresync-repo/caresync-adb-repo/landingToBronze",
					"baseParameters": {
						"landing_timestamp": {
							"value": "@variables('start_time')",
							"type": "Expression"
						},
						"source_system": {
							"value": "@activity('readTableidFromMain').output.firstRow.source_system",
							"type": "Expression"
						},
						"source_table_name": {
							"value": "@activity('readTableidFromMain').output.firstRow.bronze_table_name",
							"type": "Expression"
						},
						"source_file_format": {
							"value": "@coalesce(activity('readTableidFromMain').output.firstRow.source_file_format, '')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_adb",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "bronzeToSilverNB",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "landingToBronzeNB",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/caresync-repo/caresync-adb-repo/BronzeToSilver",
					"baseParameters": {
						"landing_timestamp": {
							"value": "@variables('start_time')",
							"type": "Expression"
						},
						"source_table_name": {
							"value": "@activity('readTableidFromMain').output.firstRow.silver_table_name",
							"type": "Expression"
						},
						"merge_keys": {
							"value": "@coalesce(activity('readTableidFromMain').output.firstRow.merge_keys, '')",
							"type": "Expression"
						},
						"load_type": {
							"value": "@activity('readTableidFromMain').output.firstRow.load_type",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_adb",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "updateStatusSuccess",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "bronzeToSilverNB",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_azureSql",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "UPDATE ctrl.audit_log SET status = 'SUCCESS', records_written = @{activity('bronzeToSilverNB').output.runOutput}, end_time = SYSUTCDATETIME()\nWHERE adf_run_id = '@{pipeline().parameters.adf_run_id}'\nAND table_id = @{pipeline().parameters.table_id}",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "checkLoadType",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "readTableidFromMain",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "startTime",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('readTableidFromMain').output.firstRow.load_type, 'FULL'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "readWaterMark",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "SELECT watermark_value FROM ctrl.watermark WHERE table_id = @{pipeline().parameters.table_id}",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "ds_azureSqlDB",
									"type": "DatasetReference"
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "storeWaterMarkValue",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "readWaterMark",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "watermark_value",
								"value": {
									"value": "@activity('readWaterMark').output.firstRow.watermark_value",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "checkingLoadTypeUpdWatarmark",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "bronzeToSilverNB",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('readTableidFromMain').output.firstRow.load_type, 'FULL'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "updateWatermarkValue",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "ls_azureSql",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "UPDATE ctrl.watermark SET watermark_value = SYSUTCDATETIME() WHERE table_id = @{pipeline().parameters.table_id}",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			},
			{
				"name": "checkSourceSystem",
				"type": "Switch",
				"dependsOn": [
					{
						"activity": "checkLoadType",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@activity('readTableidFromMain').output.firstRow.source_system",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "neon_postgres",
							"activities": [
								{
									"name": "copyFromSourceToLanding",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 3,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "PostgreSqlV2Source",
											"query": {
												"value": "SELECT * FROM PUBLIC.@{activity('readTableidFromMain').output.firstRow.source_table_name}\n@{\n  if(equals(activity('readTableidFromMain').output.firstRow.load_type, 'FULL')\n ,''\n ,concat(\n  'WHERE ', activity('readTableidFromMain').output.firstRow.watermark_column , ' > ', '''', variables('watermark_value') , ''''\n  )\n)\n}",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00"
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "ds_postgres",
											"type": "DatasetReference"
										}
									],
									"outputs": [
										{
											"referenceName": "ds_adls",
											"type": "DatasetReference",
											"parameters": {
												"container": "landing",
												"folder": {
													"value": "@concat(\n    activity('readTableidFromMain').output.firstRow.source_system,\n    '/',\n    activity('readTableidFromMain').output.firstRow.source_table_name,\n    '/',\n    variables('start_time')\n)",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						},
						{
							"value": "adls_csv",
							"activities": [
								{
									"name": "copyCSVFromsourceToLan",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 3,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "BinarySource",
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": false,
												"modifiedDatetimeStart": {
													"value": "@variables('watermark_value')",
													"type": "Expression"
												},
												"deleteFilesAfterCompletion": false
											},
											"formatSettings": {
												"type": "BinaryReadSettings"
											}
										},
										"sink": {
											"type": "BinarySink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "ds_binary_csv",
											"type": "DatasetReference",
											"parameters": {
												"container": "source",
												"folder": {
													"value": "@activity('readTableidFromMain').output.firstRow.source_path",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_binary_csv",
											"type": "DatasetReference",
											"parameters": {
												"container": "landing",
												"folder": {
													"value": "@concat(\n    activity('readTableidFromMain').output.firstRow.source_system,\n    '/',\n    activity('readTableidFromMain').output.firstRow.source_table_name,\n    '/',\n    variables('start_time')\n)",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"table_id": {
				"type": "string"
			},
			"adf_run_id": {
				"type": "string"
			}
		},
		"variables": {
			"start_time": {
				"type": "String"
			},
			"watermark_value": {
				"type": "String"
			}
		},
		"annotations": []
	}
}